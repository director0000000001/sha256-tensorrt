# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.eggs/

# ---------------------------------------------------------------------------
# Environments
# ---------------------------------------------------------------------------
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Tooling caches
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Secrets / local configuration  (NEVER commit — see docs/SECURITY.md)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
configs/local.*
# The people at this camera, one measured profile each (day 16): personal.
configs/drivers/
*.pem
*.key
credentials.json

# ---------------------------------------------------------------------------
# Model weights and downloads.
# Model files stay OUT of Git (size + license redistribution risk).
# Only metadata/manifests are tracked. See docs/architecture/AVATAR_SYSTEM.md.
# ---------------------------------------------------------------------------
models/downloads/
models/checkpoints/

# LivePortrait's weights and the ONNX build of them: 1.2 GB, fetched by
# scripts/fetch_liveportrait.py. Kept on disk so B005 can be reopened without
# downloading again; never in Git. The whole directories are named rather than
# relying on the extension patterns below, because they also carry a plugin DLL.
models/liveportrait/
models/liveportrait_onnx/
# The TensorRT experiment's ONNX exports, engines and their build records (B006).
models/tensorrt/

*.onnx
*.engine
*.plan
*.pt
*.pth
*.safetensors
*.tflite
*.task

# ---------------------------------------------------------------------------
# Avatar payloads.
# Avatar *manifests* are tracked so the library layout is reviewable;
# avatar model weights and previews are user/owner data and are not.
# ---------------------------------------------------------------------------
avatars/**/model/
avatars/**/cache/
!avatars/**/metadata.json
!avatars/**/*.md

# ---------------------------------------------------------------------------
# Runtime output — logs, captures, benchmark artifacts
# ---------------------------------------------------------------------------
logs/
*.log
benchmarks/results/
docs/benchmarks/results/
captures/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
Thumbs.db
desktop.ini
Desktop.ini
.DS_Store
.vscode/
.idea/
*.swp

# Owner-supplied window background. The path is referenced by the default
# config; the image itself is a personal choice, not project content.
assets/background.*

# Avatar source portraits. Owner/client content, and a real deliverable of the
# project rather than part of it. Manifests stay tracked so the library layout
# is reviewable.
avatars/**/*.png
avatars/**/*.jpg
avatars/**/*.jpeg
avatars/**/*.webp

# The owner's recorded driving clips: their real face, kept on this machine
# only, used to replay the engine offline. Never in Git.
recordings/

# Frames pulled out of a clip by scripts/extract_avatar_frames.py. Working
# output: the clip is the original, and anything worth keeping is copied into
# an avatar folder and named in its manifest.
extracted/

# Dense frame dumps from scripts/dump_clip_frames.py. Working material: the
# clips they came from are the originals, and what is worth keeping is copied
# into the avatar and named in its manifest.
avatars/**/frames/

# Training pairs built by scripts/make_training_pairs.py. Hundreds of megabytes,
# rebuilt exactly by the script from the frame dumps -- the recipe is in Git and
# is the thing worth reviewing. `index.json` records what a set was built from,
# so a measurement can name its dataset without the dataset being here.
data/**/*.npz
avatars/**/superseded-*/

# Manifest backups written before a ladder is installed.
*.json.bak
