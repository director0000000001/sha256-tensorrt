{
  "manifest_version": 1,
  "id": "my_avatar",
  "name": "My Avatar",
  "version": "1.0.0",
  "description": "The owner's avatar. Multiple source photographs of one identity: the engine uses the base today, and the variants as the multi-source work lands. See docs/development/AVATAR_QUALITY_BACKLOG.md.",
  "tags": [
    "owner"
  ],
  "preview": null,
  "assets": [
    {
      "path": "portrait.png",
      "role": "source_portrait",
      "optional": false
    },
    {
      "path": "portrait_smile.png",
      "role": "source_smile",
      "optional": true
    },
    {
      "path": "portrait_mouth_open.png",
      "role": "source_mouth_open",
      "optional": true
    },
    {
      "path": "portrait_eyes_closed.png",
      "role": "source_eyes_closed",
      "optional": true
    },
    {
      "path": "portrait_brows_up.png",
      "role": "source_brows_up",
      "optional": true
    },
    {
      "path": "portrait_turn_left.png",
      "role": "source_turn_left",
      "optional": true
    },
    {
      "path": "portrait_turn_right.png",
      "role": "source_turn_right",
      "optional": true
    }
  ],
  "engine": {
    "engine_id": "warp",
    "estimated_vram_mb": 0,
    "device_preference": "auto"
  },
  "rendering": {
    "output_width": 512,
    "output_height": 512,
    "background": "solid",
    "background_color": "#101014",
    "mirror": false,
    "expression_scale": 1.0,
    "head_motion_scale": 1.0
  },
  "engine_options": {},
  "fictional": true
}
