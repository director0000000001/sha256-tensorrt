{
  "manifest_version": 1,
  "id": "my_avatar",
  "name": "My Avatar",
  "version": "1.0.0",
  "description": "The owner's first real avatar, driven by the landmark-warp engine.",
  "tags": [
    "owner"
  ],
  "preview": null,
  "assets": [
    {
      "path": "portrait.png",
      "role": "source_portrait",
      "optional": false
    }
  ],
  "engine": {
    "engine_id": "warp",
    "estimated_vram_mb": 0,
    "device_preference": "auto"
  },
  "rendering": {
    "output_width": 512,
    "output_height": 512,
    "background": "solid",
    "background_color": "#101014",
    "mirror": false,
    "expression_scale": 1.0,
    "head_motion_scale": 1.0
  },
  "engine_options": {},
  "fictional": true
}
