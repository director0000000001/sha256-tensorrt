{
  "manifest_version": 1,
  "id": "my_avatar_neural2",
  "name": "My Avatar (neural, portrait 2)",
  "version": "0.1.0",
  "description": "The owner's second portrait (smiling, teeth showing; 642x673) driven by LivePortrait. Same engine options as my_avatar_neural; made 2026-09-05 to test whether a portrait that shows its teeth gives the avatar real ones.",
  "tags": [
    "owner",
    "neural"
  ],
  "preview": null,
  "assets": [
    {
      "path": "portrait.png",
      "role": "source_portrait",
      "optional": false
    }
  ],
  "engine": {
    "engine_id": "liveportrait",
    "estimated_vram_mb": 4500,
    "device_preference": "cuda"
  },
  "rendering": {
    "output_width": 1280,
    "output_height": 720
  },
  "engine_options": {
    "anchor_frames": 15,
    "crop_scale": 2.2,
    "crop_vy_ratio": -0.125,
    "stitching": false,
    "eye_gain": 0.06,
    "lip_retargeting": false,
    "lip_gain": 0.0
  }
}
