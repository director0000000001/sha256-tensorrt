{
  "manifest_version": 1,
  "id": "my_avatar_neural",
  "name": "My Avatar (neural)",
  "version": "0.1.0",
  "description": "The owner's portrait driven by LivePortrait: one photograph, a face generated every frame. The same portrait.png as my_avatar; no ladders, no clips.",
  "tags": [
    "owner",
    "neural"
  ],
  "preview": null,
  "assets": [
    {
      "path": "portrait.png",
      "role": "source_portrait",
      "optional": false
    }
  ],
  "engine": {
    "engine_id": "liveportrait",
    "estimated_vram_mb": 4500,
    "device_preference": "cuda"
  },
  "rendering": {
    "output_width": 1280,
    "output_height": 720
  },
  "engine_options": {
    "anchor_frames": 15,
    "crop_scale": 2.2,
    "crop_vy_ratio": -0.06,
    "stitching": false,
    "eye_gain": 1.0,
    "eye_headroom": 1.1,
    "eye_scale": 0.95,
    "lip_retargeting": false,
    "lip_gain": 0.0,
    "motion_smoothing": 0.0,
    "eye_expression_gain": 0.0,
    "eye_mask_output": true,
    "retarget_zero_at_rest": true,
    "expression_gates": true,
    "brow_gain": 0.0,
    "brow_follow": 1.0,
    "mouth_lateral_gain": 0.0,
    "mouth_smile_gain": 1.0,
    "mouth_tilt_trim": 0.005,
    "size_smoothing": 0.85,
    "crop_smoothing": 1.0,
    "crop_centre_smoothing": 0.0,
    "crop_smoothing_beta": 0.02,
    "rotation_pivot": "eyes",
    "pivot_z": false,
    "translation_gain_x": 1.0,
    "translation_gain_y": 0.0,
    "crop_centre": "eyeline",
    "gaze_gain": 1.0,
    "mask_jaw_shrink": 0.0,
    "expression_gain": 1.8,
    "scale_gain": 0.0,
    "chin_follow": 1.0,
    "mask_forehead_reach": 0.85,
    "edge_match": 1.0
  }
}
