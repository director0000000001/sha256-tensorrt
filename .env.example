# ---------------------------------------------------------------------------
# sha256 — example environment file
#
# Copy to `.env` and edit. `.env` is gitignored and MUST NOT be committed.
# Every variable is optional; each has a safe default in configs/default.toml.
#
# Precedence (lowest -> highest):
#   built-in defaults  ->  configs/default.toml  ->  configs/local.toml
#   ->  environment variables / .env  ->  command-line overrides
#
# All variables use the SHA256_ prefix. Nested settings use `__`.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
# One of: development | production
SHA256_ENVIRONMENT=development

# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
SHA256_LOG_LEVEL=INFO

# Emit logs as JSON lines instead of human-readable text.
SHA256_LOG_JSON=false

# Unlocks owner/developer-only features (avatar import, registry mutation,
# raw-frame inspection). Off by default — see docs/SECURITY.md.
SHA256_DEVELOPER_MODE=false


# --- Storage ---------------------------------------------------------------
# Root of the avatar library. Relative paths resolve against the repo root in
# development, and against the per-user data directory in production.
SHA256_AVATARS__LIBRARY_PATH=avatars

# Where downloaded/converted model artifacts live. Kept outside Git.
SHA256_MODELS__ROOT_PATH=models


# --- Camera ----------------------------------------------------------------
# Backend id resolved through the component registry, e.g. `null`.
# Real capture backends are not implemented yet.
SHA256_CAMERA__BACKEND=null
SHA256_CAMERA__DEVICE_INDEX=0
SHA256_CAMERA__WIDTH=1280
SHA256_CAMERA__HEIGHT=720
SHA256_CAMERA__TARGET_FPS=30


# --- Tracking / Avatar engine / Rendering ----------------------------------
# All default to `null` placeholders during the foundation phase.
SHA256_TRACKING__BACKEND=null
SHA256_ENGINE__BACKEND=null
SHA256_RENDERING__BACKEND=null
SHA256_VIRTUAL_CAMERA__BACKEND=null


# --- GPU / VRAM ------------------------------------------------------------
# Soft budget (MiB) the avatar residency cache tries to stay under before
# evicting inactive avatars. Measured, not enforced, until engines exist.
SHA256_GPU__VRAM_BUDGET_MB=6144
# How many loaded avatars may stay resident at once (active + warm spares).
SHA256_AVATARS__MAX_RESIDENT=2


# --- Performance -----------------------------------------------------------
SHA256_PERFORMANCE__ENABLED=true
# Samples retained per metric for rolling statistics.
SHA256_PERFORMANCE__WINDOW_SIZE=240


# ---------------------------------------------------------------------------
# NOTE: sha256 has no analytics, no telemetry, and no cloud dependency.
# Nothing under src/ reads a key, an endpoint or an account, and the running
# application never contacts a hosted service. See docs/PRIVACY.md.
#
# The one variable below is not the application's. It belongs to a build-time
# tool in scripts/ that generates the avatar's source clips on the owner's own
# machine, before there is an avatar to run — the same act as photographing
# oneself, done through a paid API. It is never read at runtime.
# ---------------------------------------------------------------------------

# --- Avatar clip generation (scripts/generate_avatar_clips.py) --------------
# A Google AI Studio key with Veo access. Used ONLY by that script, which
# generates the video clips the avatar's photographs are cut from, and prices
# every request against `--budget` before sending it.
#
# The key is money: anyone holding it can spend the account's balance. Keep it
# in `.env`, which is gitignored, and never in a config file or a commit.
GEMINI_API_KEY=
